<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOTE (Phase 00, run 1): this project intentionally has ZERO NuGet package
    references (no xunit, no Microsoft.NET.Test.Sdk). This sandbox's network
    allowlist blocks api.nuget.org outright (confirmed: every NuGet host
    returns a 403 through the proxy, not just Godot's download hosts), so a
    real xUnit/VSTest project cannot restore here and `dotnet test` cannot
    run. See PHASE00_PROGRESS.md, "Environment notes: NuGet is blocked here".

    Workaround: TestKit/ below is a ~150-line, dependency-free test harness
    that mirrors xUnit's surface on purpose ([Fact], Assert.Equal/True/False/
    InRange/Throws with the same names and argument order) so converting to
    real xUnit later is a mechanical swap, not a rewrite:
      1. delete TestKit/ and Program.cs
      2. add the three PackageReferences above (xunit, Microsoft.NET.Test.Sdk,
         xunit.runner.visualstudio)
      3. `dotnet test` as normal
    Until then, this project builds as a console exe and IS the test run:
      dotnet run -p:StartupProject=Genesis.Core.Tests (or just: cd Genesis.Core.Tests, dotnet run)
    Exit code 0 = all green, matching what `dotnet test` would signal.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Genesis.Core\Genesis.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\genome_fixtures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
