<?xml version="1.0" encoding="utf-8"?>
<!--
  This sandbox's network allowlist blocks nuget.org (see PHASE00_PROGRESS.md,
  "Environment notes"). Genesis.Core has zero external package dependencies
  by design, so restore only needs the .NET SDK's locally installed reference
  packs, never the network, but the default NuGet.Config still points at
  nuget.org and MSBuild's restore step fails outright if that source is
  unreachable, even when nothing would actually be downloaded from it. This
  file clears the inherited package sources and points restore at a local,
  empty, always present folder instead, so dotnet build and dotnet restore
  work fully offline. Safe to delete once this environment (or Finn's own
  machine) has real NuGet access; the project has nothing to fetch either way.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline-empty" value="./.offline-nuget-feed" />
  </packageSources>
</configuration>
